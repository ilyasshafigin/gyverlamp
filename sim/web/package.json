{
  "name": "gyverlamp-sim-web",
  "version": "0.1.0",
  "description": "Browser UI and deterministic effect exporter for GyverLamp WASM simulator",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:wasm": "cd ../wasm \u0026\u0026 ./build.sh",
    "sim": "npm run build:wasm \u0026\u0026 node server.js",
    "render:catalog": "node tools/render-effect.js catalog",
    "render:effect": "node tools/render-effect.js effect",
    "test:tools": "node --test tools/test/*.test.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "pngjs": "7.0.0"
  }
}
